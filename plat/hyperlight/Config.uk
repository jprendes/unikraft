menuconfig PLAT_HYPERLIGHT
	bool "Hyperlight guest"
	default n
	depends on ARCH_X86_64
	select LIBUKDEBUG
	select LIBUKBOOT
	select LIBUKBITOPS
	select LIBUKALLOC
	select LIBUKTIMECONV
	select LIBNOLIBC if !HAVE_LIBC
	select LIBUKATOMIC
	select LIBUKRELOC if OPTIMIZE_PIE
	select LIBUKPLAT_NATIVE_PAL
	select LIBUKPLAT_NATIVE_LCPU_PM if LIBUKLCPU
	select HAVE_INTCTLR
	select LIBUKINTCTLR_HYPERLIGHT
	help
	  Create a Unikraft image that runs as a Hyperlight guest.
	  Hyperlight is a lightweight Virtual Machine Manager (VMM)
	  designed to be embedded within applications.

if (PLAT_HYPERLIGHT)

config HYPERLIGHT_MAX_GUEST_LOG_LEVEL
	int "Maximum guest log level (0=Off, 1=Error, 2=Warn, 3=Info, 4=Debug, 5=Trace)"
	default 3
	range 0 5
	help
	  Maximum log level that will be sent to the host.
	  0 = Off, 1 = Error, 2 = Warn, 3 = Info, 4 = Debug, 5 = Trace

config HYPERLIGHT_DEBUG_PRINT
	bool "Enable debug print to host"
	default n
	help
	  Enable debug print output via Hyperlight DebugPrint port.
	  This can be useful for early boot debugging.

config HYPERLIGHT_SYSCALL_PROFILE
	bool "Enable per-syscall TSC profiler + dump"
	default n
	help
	  Record a per-syscall count + cumulative-ns table and dump it
	  to the host console on every exit/exit_group. Handy for
	  profiling the syscall hot path in the guest, but it spams
	  the user-visible output — keep off for production images.

config HYPERLIGHT_HCALL
	bool "Enable in-kernel host function call API"
	default n
	help
	  Build the in-kernel hyperlight_hcall() primitive that issues
	  synchronous Hyperlight __dispatch host function calls. Kernel
	  components (poll, hostfs, hostsock, time) use it directly.

	  When LIBDEVFS is also enabled, a /dev/hcall device is registered
	  so user-space can call host-registered functions via the same
	  dispatch protocol.

config HYPERLIGHT_POLL
	bool
	default y
	depends on LIBUKSCHED && LIBUKSCHEDCOOP
	select HYPERLIGHT_HCALL
	help
	  Add a `poll` guest function that runs the unikernel scheduler
	  until it would go idle, then exits the VM back to the host with
	  a next-wakeup deadline. The host repeatedly invokes `poll` to
	  drive execution forward. This lets a long-lived guest yield the
	  vCPU whenever it has no runnable work, instead of running a
	  single guest function to completion. Requires the in-kernel
	  host-call API (HYPERLIGHT_HCALL) to report the deadline.

	  This is how applications run on Hyperlight; there is no
	  alternative execution model. It has no prompt so it cannot be
	  turned off, but it still depends on a cooperative scheduler, and
	  kconfig disables an option whose dependencies are unmet without
	  saying so — app-elfloader turns that into a build error rather
	  than a kernel that cannot launch its application.

endif
